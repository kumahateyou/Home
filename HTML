<!DOCTYPE html>
<html lang="zh-TW">
<head>
<meta charset="UTF-8">
<title>RPG Game</title>
<style>
body {
    margin: 0;
    font-family: Arial;
    background: url("1.png") center/cover no-repeat;
    color: white;
    overflow: hidden;
}

/* 黑色遮罩讓文字更清楚 */
.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.6);
}

/* 封面 */
#cover {
    position: absolute;
	top: 50%;
	left: 50%; 
	transform: translate(-50%, -50%);
        text-align: center;
}

/* 標題 */
h1 {
    font-size: 50px;
    text-shadow: 0 0 10px #fff, 0 0 20px #f00;
}

/* 按鈕 */
button {
    padding: 15px 40px;
    font-size: 20px;
    border: none;
    border-radius: 10px;
    cursor: pointer;
    background: linear-gradient(45deg, #ff0000, #ff9900);
    color: white;
    transition: 0.3s;
}

button:hover {
    transform: scale(1.1);
}

/* 遊戲畫面（先隱藏） */
#game {
    display: none;
    margin: 0;
    font-family: Arial;
    background: url("1.png") center/cover no-repeat;
    color: white;
    overflow: hidden;
    height: 100vh;
}
</style>
</head>
<body>

<div class="overlay"></div>

<!-- 封面 -->
<div id="cover">
    <h1>⚔️ RPG ADVENTURE ⚔️</h1>
    <p>物件導向 RPG 遊戲</p>
    <button onclick="startGame()">開始遊戲</button>
</div>

<!-- 遊戲畫面 -->
<div id="game">
    <h2>🎮 遊戲開始！</h2>
    <p>這裡可以放你的戰鬥畫面</p>
</div>

<script>
function startGame() {
    document.getElementById("cover").style.display = "none";
    document.getElementById("game").style.display = "block";
}
</script>

</body>
</html>
